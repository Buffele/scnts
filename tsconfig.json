{
	"compilerOptions": {
	  "target": "es6",
	  "module": "commonjs",
	  "outDir": "dist",
	  "strict": true,
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "forceConsistentCasingInFileNames": true,
	  "allowSyntheticDefaultImports": true,
	  "noImplicitAny": false
	},
	"include": ["index.ts", "src/**/*.ts", "tests/**/*.ts"],
	"exclude": ["dist", "node_modules", "samples"]
}

{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": ["warning"],
    "noUnusedParameters": ["warning"],
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "paths": {
      "@scnts/*": ["../../src/*"]
    }
  },
  "include": ["src"]
}
